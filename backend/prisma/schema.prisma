generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model user {
  user_id        Int                 @id @default(autoincrement())
  username       String              @unique(map: "username") @db.VarChar(20)
  role_id        String              @default("69be0504eeb8e6106b1787fb") @db.VarChar(24)
  password_hash  String              @db.VarChar(255)
  signature      String              @default("这个人很赖，什么都没有留下~") @db.VarChar(200)
  publish_time   DateTime?           @default(now()) @db.DateTime(0)
  update_time    DateTime?           @default(now()) @db.DateTime(0)
  cover          String?             @db.VarChar(500)
  account_status user_account_status @default(ACTIVE)
  phone          String              @unique(map: "phone") @db.VarChar(11)
  deleted        Int                 @default(0) @db.TinyInt
}

enum user_account_status {
  ACTIVE
  BLACKLISTED
}
