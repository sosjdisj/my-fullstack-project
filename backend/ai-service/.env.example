# AI Service 环境变量配置
# 复制此文件为 .env 并填入实际值

# LLM（OpenAI 兼容协议，默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-flash

# Embedding（本地 sentence-transformers 模型，首次运行自动下载到 HF 缓存）
EMBEDDING_MODEL=google/embeddinggemma-300m

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Qdrant（本地 Docker 或云服务）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=article_chunks

# MongoDB
MONGODB_URI=mongodb://localhost:27017/myblog

# Redis
REDIS_URL=

# Java Backend
JAVA_BACKEND_URL=http://localhost:3001
