# Docker Compose 环境变量
# 复制此文件为 .env（项目根目录）并填入实际值

# MySQL root 密码（java-backend 共用）
MYSQL_ROOT_PASSWORD=change_me_strong

# JWT 签名密钥（随机长字符串，勿用本地开发值）
JWT_SECRET=change_me_to_random_string

# 对外访问地址（如 http://your-server.com），用于 CORS 白名单；同源部署可留默认
#PUBLIC_URL=http://your-domain.com

# HTTPS 部署时改为 true（Cookie 安全属性）
#COOKIE_SECURE=false

# 主应用对外端口
#APP_PORT=80

# HuggingFace 镜像加速（国内服务器建议取消注释）
#HF_ENDPOINT=https://hf-mirror.com
