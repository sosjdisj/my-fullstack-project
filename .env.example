# ============================================
# 后端环境变量 (Backend)
# ============================================

# 应用环境
code
NODE_ENV=development

# 服务器端口
PORT=3001

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# 前端基础URL（用于生成文件链接等）
BASE_URL=http://localhost:3001

# JWT 密钥（用于Token签名，请使用强密码）
JWT_SECRET=your_jwt_secret_key_here

# MongoDB 连接字符串
MONGODB_URI=mongodb://localhost:27017/myblog

# MariaDB 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=myblog

# 阿里云短信服务配置（可选）
ALIYUN_SMS_ACCESS_KEY=your_aliyun_access_key
ALIYUN_SMS_SECRET=your_aliyun_secret
ALIYUN_SMS_SIGN=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=your_template_code

# AI 模型配置（Ollama）
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# 前端环境变量 (Frontend)
# ============================================

# API 基础地址
VITE_API_BASE_URL=http://localhost:3001/api

# WebSocket 连接地址
VITE_SOCKET_URL=http://localhost:3002

# 应用基础路径（用于部署到子目录）
VITE_BASE_URL=/
